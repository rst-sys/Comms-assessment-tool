# Provider credential. Never commit a real key.
# ACR_API_KEY is read first; ANTHROPIC_API_KEY is the fallback. Use ACR_API_KEY
# in hosted environments that reserve ANTHROPIC_API_KEY for their own auth.
ACR_API_KEY=

# Model id sent on every evaluation call. Shown in the privacy panel.
ACR_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
ACR_EFFORT=high

# Output ceiling for the analysis JSON.
ACR_MAX_OUTPUT_TOKENS=16000

# Privacy panel text. Set these to the provider's actual terms for the endpoint in use.
ACR_PROCESSING_MODE=Zero-retention API
ACR_TRAINING_TERM=Not used to train models
